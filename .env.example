# ===== Supabase(バックエンド担当者から共有してもらう)=====
# 未設定の場合、データは端末のローカルストレージに保存されます(プレビュー用)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ===== Dify(開発時の直接接続用・本番では使わない)=====
# 本番では Supabase Edge Function (dify-chat) 経由で接続するため不要。
# ローカル開発で直接 Dify に繋ぎたい場合のみ設定してください。
# ※フロントに埋め込んだキーは公開されるため、本番ビルドには絶対に含めないこと
VITE_DIFY_API_URL=https://api.dify.ai/v1
VITE_DIFY_API_KEY=
